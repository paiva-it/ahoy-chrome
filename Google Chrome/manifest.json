{
  "manifest_version": 3,
  "name": "Ahoy! Personal",
  "description": "Route selected sites through your local DNS helper or your own proxy. No telemetry.",
  "version": "4.0.0",
  "minimum_chrome_version": "120",
  "permissions": [
    "proxy",
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ahoy! Personal",
    "default_popup": "views/popup.html"
  },
  "options_page": "views/options.html",
  "icons": {
    "16": "icons/color/16x16.png",
    "48": "icons/color/48x48.png",
    "128": "icons/color/128x128.png"
  }
}
